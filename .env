# Example environment variables for development
# Copy this file to `.env.local` or `.env` and fill in your own values.
# Set your backend URL (no trailing slash). Vite exposes variables that start with VITE_
VITE_BACKEND_URL=http://localhost:3000
VITE_SUPABASE_URL=your-supabase-url-here
VITE_SUPABASE_KEY=your-supabase-key-here
